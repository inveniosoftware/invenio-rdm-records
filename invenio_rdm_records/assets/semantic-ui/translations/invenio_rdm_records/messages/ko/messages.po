msgstr "언어"

msgid "Search for a language by name (e.g \"eng\", \"fr\" or \"Polish\")"
msgstr "이름으로 언어 검색 (예: \"eng\", \"fr\" 또는 \"Polish\")"

msgid "Add standard"
msgstr "표준 추가"

msgid "Add custom"
msgstr "직접 추가"

