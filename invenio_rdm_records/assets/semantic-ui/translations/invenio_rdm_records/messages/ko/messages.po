msgstr "파일 제거"

msgid "or"
msgstr "또는"

msgid "This is a Metadata-only record."
msgstr "이것은 메타데이터 전용 레코드입니다."

msgid "Metadata-only record"
msgstr "메타데이터 전용 레코드"

msgid "Disable files for this record"
msgstr "이 레코드의 파일 비활성화"

msgid "Storage available"
msgstr "사용 가능한 저장 공간"

