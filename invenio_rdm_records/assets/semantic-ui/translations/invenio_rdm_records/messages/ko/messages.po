msgstr "식별자 추가"

msgid "Identifier"
msgstr "식별자"

msgid "Scheme"
msgstr "스킴"

msgid "Do you already have a {{pidLabel}} for this upload?"
msgstr "이 업로드에 대한 {{pidLabel}}이(가) 이미 있으신가요?"

msgid "Yes, I already have one"
msgstr "예, 이미 있습니다"

msgid "No, I need one"
msgstr "아니요, 필요합니다"

msgid "No, I don't need one"
msgstr "아니요, 필요하지 않습니다"

msgid "Search for languages..."
msgstr "언어 검색..."

