msgstr "라이선스"

msgid "Read more"
msgstr "자세히 보기"

msgid "Title is a required field."
msgstr "제목은 필수 항목입니다."

msgid "Link must be a valid URL"
msgstr "링크는 올바른 URL이어야 합니다"

